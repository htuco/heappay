HOST=127.0.0.1
PORT=8000
RELOAD=true
# FORWARDED_ALLOW_IPS=*
#for deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Optional — Supabase Storage for POST /storage/images and POST /auth/me/avatar
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
# Private buckets: API responses swap public URLs for signed URLs (default TTL 7 days).
# SUPABASE_AVATAR_SIGNED_TTL_SECONDS=604800
