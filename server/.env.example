HOST=127.0.0.1
PORT=8000
RELOAD=true
# FORWARDED_ALLOW_IPS=*
#for deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# TOTP 2FA — generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Optional SMTP for password reset and transaction email notifications.
# When unset, emails are logged to the server console instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# MAIL_FROM=noreply@heap.example

COHERE_API_KEY=your-cohere-api-key
GROQ_API_KEY=your-groq-api-key

# Database — for Supabase dev, prefer the transaction pooler (port 6543), not session (5432).
# Session mode caps at ~15 connections; the API + scheduler can exhaust that quickly.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# For local Postgres: DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/heap

# Optional — Supabase Storage for POST /storage/images and POST /auth/me/avatar
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
# Private buckets: API responses swap public URLs for signed URLs (default TTL 7 days).
# SUPABASE_AVATAR_SIGNED_TTL_SECONDS=604800

# Transaction processor (also runs in-app on server start; see TX_PROCESSOR_SCHEDULER_ENABLED)
# TX_PROCESSOR_SCHEDULER_ENABLED=true
# TX_PROCESSOR_INTERVAL_SECONDS=60
# TX_PROCESSOR_BATCH_SIZE=100
# CARD_EXPIRATION_BATCH_SIZE=100
# TX_MIN_PROCESSING_DELAY_SECONDS=3
# TX_MANUAL_REVIEW_ABOVE_AMOUNT=500000.00
# TX_PENDING_MAX_AGE_MINUTES=1440
# TX_PENDING_TIMEOUT_ACTION=deny
# TX_STAFF_BYPASS_DELAY=false
# TX_USER_APPROVAL_ABOVE_AMOUNT=100.00
# TX_USER_APPROVAL_TIMEOUT_MINUTES=15
# TX_USER_APPROVAL_TYPE_NAMES=fine
# TX_DUPLICATE_WINDOW_SECONDS=90

# Refund processor (optional second phase of the cron job)
# REFUND_PROCESSOR_ENABLED=false
# REFUND_MIN_PROCESSING_DELAY_SECONDS=3
# REFUND_AUTO_ALLOW_MAX_AMOUNT=25.00
# REFUND_MAX_AGE_DAYS=7
